JEV_API_KEY=
RIVER_API_KEY=
RIVER_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
MEMENTO_EMAIL_TO=you@example.com
MEMENTO_TIMEZONE=America/Los_Angeles
MEMENTO_SYNC_SECONDS=20
# Optional overrides for the isolated GBrain install:
# MEMENTO_GBRAIN_CHECKOUT=/absolute/path/to/gbrain/checkout
# MEMENTO_GBRAIN_HOME=/absolute/path/to/gbrain/home
# MEMENTO_DATA_DIR=/absolute/path/to/private/runtime
# To share one running GBrain HTTP owner with existing agents:
# MEMENTO_GBRAIN_MCP_URL=http://127.0.0.1:3131/mcp
# MEMENTO_GBRAIN_MCP_CREDENTIALS=/absolute/private/gbrain-mcp-client.json
# A bearer token can be used instead of renewable credentials:
# MEMENTO_GBRAIN_MCP_TOKEN=
